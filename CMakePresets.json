{
    "version": 8,
    "configurePresets": [
        {
            "name": "macOS Clang (homebrew)",
            "displayName": "macOS Clang (homebrew)",
            "description": "Using compilers: C = /opt/homebrew/opt/llvm/bin/clang, CXX = /opt/homebrew/opt/llvm/bin/clang++",
            "binaryDir": "${sourceDir}/build-clang",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-clang/install",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macOS GCC (homebrew)",
            "displayName": "macOS GCC (homebrew)",
            "description": "Using compilers: C = /opt/homebrew/bin/aarch64-apple-darwin25-gcc-16, CXX = /opt/homebrew/bin/aarch64-apple-darwin25-g++-16",
            "binaryDir": "${sourceDir}/build-gcc",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-gcc/install",
                "CMAKE_C_COMPILER": "/opt/homebrew/bin/aarch64-apple-darwin25-gcc-16",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/aarch64-apple-darwin25-g++-16",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "lhs": "${hostSystemName}",
                "type": "equals",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macOS Clang (homebrew)",
            "configurePreset": "macOS Clang (homebrew)"
        },
        {
             "name": "macOS GCC (homebrew)",
            "configurePreset": "macOS GCC (homebrew)"
        }
    ]
}